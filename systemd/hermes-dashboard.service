[Unit]
Description=Hermes Agent Web Dashboard & PIN Gate
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/hermes-dashboard
Environment=PORT=8080
Environment=PIN_CODE=684861
Environment=NODE_ENV=production
Environment=PATH=/opt/hermes-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/node /opt/hermes-dashboard/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
